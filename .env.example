# 模型后端：ollama（本地，无需 API Key）| anthropic（Anthropic 云端 Claude）
LLM_BACKEND=ollama

# ---------- Ollama（当 LLM_BACKEND=ollama 时使用，可选） ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:32b
# 若 SDK 通过 CLI 调用，可指定路径
# CLAUDE_CLI=

# ---------- Anthropic 云端（当 LLM_BACKEND=anthropic 时使用） ----------
# 需在 https://console.anthropic.com 获取 API Key
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---------- Web UI ----------
HOST=0.0.0.0
PORT=7860
